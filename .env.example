# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
# またはルートの service_account.json（gitignore 済み）
# OAuth 利用時は下記 3 つを設定（docs/OAUTH.md 参照）

# AUTH_SECRET=
# AUTH_URL=http://localhost:3010
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

SPREADSHEET_ID=1Mc3pX949vlO_uxWpimn7_DsUAYr87GmroqXft6fvB4I
# SPREADSHEET_DISPLAY_TITLE=PJ140_wiki付与_view_test
ENABLE_SHEET_WRITES=true
SHEET_CACHE_DIR=.cache
# キュー index / Wiki 履歴で読み取る最大データ行数（未設定なら 30000）
DEFAULT_INDEX_ROWS=30000

# 推奨: Vercel Marketplace の Upstash Redis / Vercel KV を接続すると、
# Vercel の複数インスタンスで構造・キュー・Wiki履歴・行データを共有できる。
# 未設定だとインスタンスごとに個別キャッシュとなり、Sheets APIへの重複アクセスや
# 429（レート制限）が増えやすい（docs/DEPLOY.md 参照）。
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Upstash名の環境変数を使う場合:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# 設定後は GET /api/cache の sharedCache.configured / reachable で確認できる。
